# Gmail + RSVP configuration
#
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Never commit real credentials.

# ---------------------------------------------------------------------------
# Where the RSVP emails are delivered
# ---------------------------------------------------------------------------
# The address that receives every RSVP (e.g. the couple's inbox).
RSVP_TO_EMAIL=you@example.com

# Display name shown in the "From" field of the outgoing email.
# Leave blank to use the couple's name from data.json ("Hers & His").
RSVP_SENDER_NAME=

# ---------------------------------------------------------------------------
# Google OAuth credentials
# ---------------------------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Enable the Gmail API for the project first.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# The refresh token is long-lived. Generate it once with:
#   node scripts/gmail-auth.mjs
GMAIL_REFRESH_TOKEN=

# The Gmail account that sends the mail. Must match the account the refresh
# token was granted for.
GMAIL_SENDER_ADDRESS=

# Redirect URI used only by scripts/gmail-auth.mjs. Must be registered in the
# Google Cloud Console as an authorized redirect URI.
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
